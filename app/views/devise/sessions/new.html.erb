<div class="min-h-screen flex items-center justify-center px-4">
  <div class="max-w-md w-full bg-brand-surface p-8 rounded-2xl border border-brand-border shadow-2xl">
    <h2 class="text-xl font-bold text-white text-center mb-6">Log in</h2>

    <%= render "devise/shared/auth_header" %>


    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-slate-400 mb-2" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input" %>
      </div>

      <div class="relative">
        <%= f.label :password, class: "block text-sm font-medium text-slate-400 mb-2" %>
        <div class="relative flex items-center">
          <%= f.password_field :password, autocomplete: "current-password", class: "form-input w-full pr-12", id: "password-field" %>
          <span id="toggle-password" class="material-icons absolute right-3 cursor-pointer text-slate-400 hover:text-white select-none">
            visibility
          </span>
        </div>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center gap-2">
          <%= f.check_box :remember_me, class: "w-4 h-4 rounded border-brand-border bg-slate-900 text-brand-primary focus:ring-brand-primary" %>
          <%= f.label :remember_me, class: "text-sm text-slate-400" %>
        </div>
      <% end %>

      <div>
        <%= f.submit "Log in", class: "btn-primary w-full" %>
      </div>
    <% end %>

    <div class="mt-6 text-center text-sm">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
<script type="text/javascript" nonce="<%= content_security_policy_nonce %>">

$(document).on("click", "#toggle-password", function () {
  const input = $("#password-field");
  const icon = $(this);

  if (input.attr("type") === "password") {
    input.attr("type", "text");
    icon.text("visibility_off");
  } else {
    input.attr("type", "password");
    icon.text("visibility");
  }
});
</script>
