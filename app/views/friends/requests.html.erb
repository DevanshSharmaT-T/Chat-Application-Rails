<%# THE WAIT PAGE - User see pending requests here %>
<div class="max-w-2xl mx-auto p-6">
  <div class="card-main">
    <div class="mb-6 border-b border-gray-800 pb-4 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-blue-400">Friend Requests</h1>
      <%= link_to "← Back to Chat", dashboard_users_path, class: "text-sm text-gray-500 hover:text-blue-400 transition-colors" %>
    </div>

    <%# INCOMING - User B sees these %>
    <div class="mb-8">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 mb-4">Incoming Requests</h2>

      <% if @pending_received.any? %>
        <div class="space-y-3">
          <% @pending_received.each do |req| %>
            <div class="flex items-center justify-between bg-gray-900 border border-gray-800 rounded-xl p-4 hover:border-blue-500/30 transition-all">
              <div class="flex items-center gap-3">
                <div class="avatar-circle w-10 h-10"><%= req.user.first_name.first.upcase %></div>
                <div>
                  <p class="font-medium text-gray-200"><%= req.user.full_name %></p>
                  <p class="text-xs text-gray-500"><%= req.user.status.presence || "Wants to connect" %></p>
                </div>
              </div>
              <div class="flex gap-2">
                <%= button_to "Accept", friend_path(req, friend: { status: 'accepted' }), method: :patch, class: "text-sm bg-blue-600 hover:bg-blue-500 text-white px-4 py-1.5 rounded-lg transition-colors font-medium" %>
                <%= button_to "Decline", friend_path(req), method: :delete, class: "text-sm bg-gray-800 hover:bg-red-900/40 text-red-400 border border-red-900/30 px-4 py-1.5 rounded-lg transition-colors font-medium" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-8 bg-gray-900/50 rounded-xl border border-dashed border-gray-800">
          <p class="text-gray-500 text-sm">No incoming requests.</p>
        </div>
      <% end %>
    </div>

    <%# OUTGOING - User A sees these (waiting) %>
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 mb-4">Sent Requests</h2>

      <% if @pending_sent.any? %>
        <div class="space-y-3">
          <% @pending_sent.each do |req| %>
            <div class="flex items-center justify-between bg-gray-900 border border-gray-800 rounded-xl p-4 opacity-70">
              <div class="flex items-center gap-3">
                <div class="avatar-circle w-10 h-10"><%= req.friend_user.first_name.first.upcase %></div>
                <div>
                  <p class="font-medium text-gray-200"><%= req.friend_user.full_name %></p>
                  <p class="text-xs text-yellow-500/70">Waiting for approval...</p>
                </div>
              </div>
              <%= button_to "Cancel", friend_path(req), method: :delete, class: "text-xs text-gray-500 hover:text-red-400 border border-gray-800 px-3 py-1 rounded-lg transition-colors" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-8 bg-gray-900/50 rounded-xl border border-dashed border-gray-800">
          <p class="text-gray-500 text-sm">No sent requests.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
