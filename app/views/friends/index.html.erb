<% if @friends_list.any? %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <% @friends_list.each do |friend| %>
      <% friendship = Friend.find_by(user_id: current_user.id, friend_user_id: friend.id) || Friend.find_by(user_id: friend.id, friend_user_id: current_user.id) %>

      <div class="friend-row bg-gray-900 border border-gray-800 p-4 rounded-xl flex items-center gap-4 cursor-pointer hover:border-blue-500/50 transition-all" 
           data-chat-id="<%= friendship&.chat&.id %>"
           data-chat-type="Friend">
        <div class="w-12 h-12 bg-blue-900/30 text-blue-400 rounded-full flex items-center justify-center font-bold">
          <%= friend.first_name[0] %>
        </div>
        <div>
          <p class="font-medium text-gray-200"><%= friend.full_name %></p>
          <p class="text-xs text-gray-500 line-clamp-1"><%= friend.status %></p>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-20 bg-gray-900/50 rounded-2xl border border-dashed border-gray-800">
    <p class="text-gray-500">No friends found. Use the search to find people.</p>
  </div>
<% end %>
