<div class="space-y-6">
  <div class="relative">
    <input type="text" 
           id="user-search-input" 
           placeholder="Search for people..." 
           class="w-full bg-gray-900 border border-gray-800 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 transition-all">
    <div class="absolute right-4 top-3.5 text-gray-500">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
  </div>

  <% if @possible_friends_list.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="possible-friends-grid">
      <% @possible_friends_list.each do |user| %>
        <div class="user-card bg-gray-900 border border-gray-800 rounded-2xl p-6 flex flex-col items-center text-center hover:border-blue-500/30 transition-all group" 
             data-name="<%= user.full_name.downcase %>">
          
          <div class="w-20 h-20 bg-blue-900/20 text-blue-400 rounded-full flex items-center justify-center text-2xl font-bold mb-4 group-hover:scale-105 transition-transform">
            <%= user.first_name[0] %>
          </div>

          <h3 class="text-lg font-semibold text-white mb-1"><%= user.full_name %></h3>
          <p class="text-sm text-gray-500 mb-6 line-clamp-2 min-h-[40px]">
            <%= user.status.presence || "Hey there! I'm using Chat." %>
          </p>

          <%= button_to friends_path(friend_user_id: user.id), 
                        method: :post, 
                        class: "w-full py-2.5 bg-blue-600 hover:bg-blue-500 text-white rounded-lg font-medium transition-colors flex items-center justify-center gap-2" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Add Friend
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-20 bg-gray-900/50 rounded-2xl border border-dashed border-gray-800">
      <p class="text-gray-500">No new people to find right now.</p>
    </div>
  <% end %>
</div>

<script nonce="<%= content_security_policy_nonce %>">
  $(document).on('turbo:load', function() {
    $('#user-search-input').off('keyup.findFriends').on('keyup.findFriends', function() {
      const value = $(this).val().toLowerCase();
      $('#possible-friends-grid .user-card').filter(function() {
        $(this).toggle($(this).data('name').indexOf(value) > -1);
      });
    });
  });
</script>
