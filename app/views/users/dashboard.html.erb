<div class="mx-auto p-8 pb-4">
  <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">

    <!-- LEFT PANEL -->
    <section class="lg:col-span-1 border-r border-gray-800 pr-4 card-main flex flex-col">

      <!-- Tabs (border now connects to vertical border) -->
      <div class="border-b border-gray-800 pb-3 flex gap-2">
        <button
          class="tab-button px-4 py-2 rounded-full text-sm font-semibold tracking-tight transition-all duration-200
                 bg-blue-500/10 text-blue-400 border border-blue-400/30 shadow-sm"
          data-target="friends"
          data-url="<%= friends_path %>">
          Friends
        </button>

        <button
          class="tab-button px-4 py-2 rounded-full text-sm font-semibold tracking-tight transition-all duration-200
                 text-gray-400 hover:text-blue-400 hover:bg-blue-500/10"
          data-target="groups"
          data-url="<%= groups_path %>">
          Groups
        </button>

        <button
          class="tab-button px-4 py-2 rounded-full text-sm font-semibold tracking-tight transition-all duration-200
                 text-gray-400 hover:text-blue-400 hover:bg-blue-500/10"
          data-target="find_friends"
          data-url="<%= find_friends_users_path %>">
          Find People
        </button>
      </div>

      <!-- Content -->
      <div id="dashboard-content" class="mt-4">
        <%= render template: "friends/index" %>
      </div>
    </section>

    <!-- RIGHT PANEL -->
    <section class="lg:col-span-4" id="chat-window">
      <div class="card-main h-[70vh] flex items-center justify-center text-center">
        <p class="text-gray-500">Pick friend or group. Fire talk start.</p>
      </div>
    </section>

  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
  $(function() {
    window.currentUserId = "<%= current_user.id %>";
    window.activeChatType = null;

    function bootTimeago() {
      if (window.timeago?.render) {
        window.timeago.render(document.querySelectorAll('.timeago'));
      }
    }

    function scrollToBottom() {
      const $container = $('#messages-scroll-container');
      $container.scrollTop($container.prop('scrollHeight'));
    }

    function bindOlderMessages() {
      $('#chat-window').off('click.olderMessages', '.older-messages-link').on('click.olderMessages', '.older-messages-link', function(event) {
        event.preventDefault();
        const url = $(this).attr('href');

        $.get(url, function(html) {
          const $payload = $('<div>').html(html);
          const $batch = $payload.find('#older-messages-batch').children();
          const $nextLink = $payload.find('#older-next-link').html();
          $('#messages-list').prepend($batch);
          $('#history-loader').html($nextLink);
          bootTimeago();
        });
      });
    }

    function bindMessageForm() {
      $('#chat-window').off('submit.chatForm').on('submit.chatForm', '#chat-message-form', function(event) {
        event.preventDefault();
        const $form = $(this);
        const chatId = $form.find('input[name="chat_id"]').val(); 
        const $input = $('#chat-message-body');
        const body = $input.val().trim();

        if (!chatId || body.length === 0) return;

        const $btn = $form.find('[type="submit"]');
        $btn.prop('disabled', true);

        $.ajax({
          url: $form.attr('action'),
          method: 'POST',
          dataType: 'json',
          headers: {
            'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content'),
            'Accept': 'application/json'
          },
          data: $form.serialize(), 
          success: function(response) {
            $input.val('');
          },
          error: function(xhr) {
            console.error("Submission error:", xhr.responseText);
            alert('Cannot send! Check console.');
          },
          complete: function() {
            $btn.prop('disabled', false);
            $input.focus();
          }
        });
      });
    }

    // --- REVERSE INFINITE SCROLL ---
    function bindInfiniteScroll() {
      const $container = $('#messages-scroll-container');
      
      $container.off('scroll.infinite').on('scroll.infinite', function() {
        if ($(this).scrollTop() < 50) { // Trigger near top
          const $loadLink = $('.older-messages-link');
          if ($loadLink.length && !window.isLoadingOlder) {
            window.isLoadingOlder = true;
            
            // Record height before load to maintain scroll position
            const oldHeight = $container.prop('scrollHeight');
            const url = $loadLink.attr('href');
 
            $.get(url, function(html) {
              const $payload = $('<div>').html(html);
              const $batch = $payload.find('#older-messages-batch').children();
              const $nextLink = $payload.find('#older-next-link').html();
 
              $('#messages-list').prepend($batch);
              $('#history-loader').html($nextLink);
              
              // Maintain scroll position (WhatsApp style)
              const newHeight = $container.prop('scrollHeight');
              $container.scrollTop(newHeight - oldHeight);
              
              bootTimeago();
              window.isLoadingOlder = false;
            });
          }
        }
      });
    }
 
    function bindConversationRows() {
      $('#dashboard-content').off('click.chatLoad', '.friend-row, .group-row').on('click.chatLoad', '.friend-row, .group-row', function() {
        const chatId = $(this).data('chat-id');
        const chatType = $(this).data('chat-type');
        if (!chatId) return;
 
        window.activeChatType = chatType;
        $('#chat-window').load('/chats/' + chatId + '/messages', function() {
          window.ChatRealtime.subscribe(chatId);
          bootTimeago();
          scrollToBottom();
          bindMessageForm();
          bindInfiniteScroll(); // Setup the scroll listener
        });
      });
    }

    $(document).off('click.dashboardTabs', '.tab-button').on('click.dashboardTabs', '.tab-button', function() {
      const $btn = $(this);
      const url = $btn.data('url');

      $('.tab-button')
        .removeClass('bg-blue-500/10 text-blue-400 border border-blue-400/30 shadow-sm')
        .addClass('text-gray-400');

      $btn
        .removeClass('text-gray-400')
        .addClass('bg-blue-500/10 text-blue-400 border border-blue-400/30 shadow-sm');

      $('#dashboard-content').fadeOut(100, function() {
        $(this).load(url, function() {
          $(this).fadeIn(100);
          bindConversationRows();
        });
      });
    });

    bindConversationRows();
  });
</script>
