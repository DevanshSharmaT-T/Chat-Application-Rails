<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Chat App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Chat App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" nonce="<%= content_security_policy_nonce %>"></script>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :tailwind, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="antialiased">

    <div class="bg-animated-layer">
      <div class="el"></div>
    </div>

    <main class="relative z-10">
      <% if user_signed_in? %>
        <header class="mx-auto px-6 pt-6" style="overflow: visible !important;">
          <div class="flex items-center justify-between card-main" style="overflow: visible !important; position: relative; z-index: 40;">
              <%= link_to dashboard_users_path, class: "text-5xl md:text-3xl font-extrabold tracking-tight text-blue-600 hover:text-blue-700 transition-colors duration-200" do %>
                <span class="text-blue-600 hover:text-white">Chat</span>
                <span class="text-gray-100 hover:text-blue-600">App</span>
              <% end %>

              <div class="relative">
                <button
                  id="profile-dropdown-toggle"
                  type="button"
                  class="flex items-center gap-3 px-3 py-2 rounded-lg border border-blue-200 bg-white/5 hover:bg-white/10 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-300"
                >
                  <div class="avatar-circle w-10 h-10 flex items-center justify-center rounded-full bg-blue-100 text-blue-600 font-semibold border border-blue-200">
                    <%= current_user.first_name.to_s.first&.upcase || current_user.email.to_s.first&.upcase %>
                  </div>
              
                  <div class="text-left leading-tight">
                    <p class="text-sm font-medium text-white">
                      <%= current_user.full_name %>
                    </p>
                    <p class="text-xs text-gray-400">
                      <%= current_user.status.presence || "Offline" %>
                    </p>
                  </div>
                </button>
              
                <!-- ✅ Improved Dropdown -->
                <div
                  id="profile-dropdown-menu"
                  class="dropdown-menu hidden absolute right-0 mt-2 w-56 rounded-2xl bg-gray-900 border border-gray-700 shadow-xl backdrop-blur-md z-50"
                >
                  <div class="py-2 px-1">
              
                    <% pending_count = @pending_requests&.count || 0 %>
              
                    <%= link_to requests_friends_path, class: "flex items-center justify-between px-3 py-2 text-sm text-gray-300 hover:bg-gray-800 hover:text-white rounded-lg transition-colors" do %>
                      <span>Requests</span>
                      <% if pending_count > 0 %>
                        <span class="bg-blue-600 text-white text-xs font-bold px-2 py-0.5 rounded-full">
                          <%= pending_count %>
                        </span>
                      <% end %>
                    <% end %>
              
                    <%= link_to new_group_path, class: "flex items-center px-3 py-2 text-sm text-gray-300 hover:bg-gray-800 hover:text-white rounded-lg transition-colors" do %>
                      <span>Create Group</span>
                    <% end %>
              
                    <%= link_to "View Profile",
                      user_path(current_user),
                      class: "flex items-center px-3 py-2 text-sm text-gray-300 hover:bg-gray-800 hover:text-white rounded-lg transition-colors"
                    %>
              
                    <div class="border-t border-gray-700 my-1"></div>
              
                    <%= button_to "Sign Out",
                      destroy_user_session_path,
                      method: :delete,
                      class: "flex items-center w-full text-left px-3 py-2 text-sm text-red-400 hover:bg-red-900/20 rounded-lg transition-colors bg-transparent border-none cursor-pointer"
                    %>
              
                  </div>
                </div>
              </div>
          </div>
        </header>
      <% end %>

      <div>
        <% if notice.present? %>
          <p class="notice text-sm text-blue-400 mb-2"><%= notice %></p>
        <% end %>
        <% if alert.present? %>
          <p class="alert text-sm text-red-500 mb-2"><%= alert %></p>
        <% end %>
      </div>

      <%= yield %>
    </main>

    <script type="text/javascript" nonce="<%= content_security_policy_nonce %>">
      $(document).off('click', '#profile-dropdown-toggle').on('click', '#profile-dropdown-toggle', function(e) {
        e.preventDefault();
        e.stopPropagation();
        console.log("Chief click head!"); // Look in console for this!
        $('#profile-dropdown-menu').toggleClass('hidden');
      });
      
     $(document).on('click', function(e) {
        if (!$(e.target).closest('#profile-dropdown-toggle, #profile-dropdown-menu').length) {
            $('#profile-dropdown-menu').addClass('hidden');
        }
     });
    </script>
  </body>
</html>
