<% if @groups_list.any? %>
  <div class="grid gap-4">
    <% @groups_list.each do |group| %>
      <div class="card-main group-row cursor-pointer hover:border-blue-500/40 transition-all" data-chat-id="<%= group.chat&.id %>" data-chat-type="Group">
        <div class="flex items-center gap-4">
          <div class="avatar-circle w-12 h-12">
            <%= group.name.to_s.first&.upcase || "G" %>
          </div>
          <div>
            <p class="font-medium text-gray-200"><%= group.name %></p>
            <p class="text-xs text-gray-500 line-clamp-1"><%= group.description.presence || "No group description yet." %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-20 bg-gray-900/50 rounded-2xl border border-dashed border-gray-800">
    <p class="text-gray-500">No groups found. Create or join one to get started.</p>
  </div>
<% end %>
