<div class="card-main h-[70vh] flex flex-col" data-chat-id="<%= chat.id %>" id="active-chat-window">

  <!-- Header -->
  <div class="chat-header">
    <h2 class="text-lg font-semibold text-gray-200">
      <%= chat.chat_name.presence || "Chat" %>
    </h2>
    <p class="text-xs text-gray-500">
      <%= chat.chatable_type == "Group" ? "Group chat" : "Direct chat" %>
    </p>
  </div>

  <!-- Messages -->
  <div class="messages-container" id="messages-scroll-container">
    <div id="history-loader" class="mb-3">
      <% if next_page.present? %>
        <%= link_to "Load older", chat_messages_path(chat_id: chat.id, page: next_page, prepend: 1),
            class: "text-xs text-blue-400 nav-link older-messages-link" %>
      <% end %>
    </div>

    <div id="messages-list" class="space-y-3">
      <%= render partial: "messages/message_bubble", collection: messages, as: :message %>
    </div>
  </div>

  <!-- Form footer -->
  <div class="chat-form-footer">
    <% if chat.chatable_type == 'Friend' && chat.chatable.status == 'pending' %>
      <div class="waiting-state">
        <p class="text-yellow-500 font-semibold" id="waiting-for-friend-msg">Waiting for Friend</p>
        <p class="text-xs text-gray-500 mt-1">Friend must approve before talk start.</p>
      </div>
    <% else %>
      <form id="chat-message-form"
            action="<%= chat_messages_path(chat_id: chat.id) %>"
            method="POST"
            data-remote="true"
            class="flex items-center gap-2">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <input type="hidden" name="chat_id" value="<%= chat.id %>">
        <button type="button" id="emoji-toggle" class="btn-emoji">😀</button>
        <input type="text" name="message[body]" id="chat-message-body"
               class="message-input"
               placeholder="Type message..."
               autocomplete="off">
        <button type="submit" class="btn-primary">Send</button>
      </form>
    <% end %>
  </div>

</div>
