<div id="older-messages-batch">
  <%= render partial: "messages/message_bubble", collection: messages, as: :message %>
</div>

<div id="older-next-link">
  <% if next_page.present? %>
    <%= link_to "Load older", chat_messages_path(chat_id: params[:chat_id], page: next_page, prepend: 1), class: "text-xs text-blue-400 nav-link older-messages-link" %>
  <% end %>
</div>
